# Kopieren nach .env, dann: chmod 600 .env
# Diese Datei NIEMALS teilen, hochladen oder in Git einchecken.

# Erzeugen mit: python3 -m jarvis secret
JARVIS_APPROVAL_SECRET=

# Von @BotFather (erst nach deiner Freigabe anlegen)
TELEGRAM_BOT_TOKEN=

# Version 5: Schlüssel für ein externes KI-Modell (erst nach deiner Freigabe, siehe docs/18).
# In config/jarvis.json steht dann nur der NAME dieser Variable unter "key_env", niemals der Schlüssel selbst.
# JARVIS_OPENROUTER_KEY=
