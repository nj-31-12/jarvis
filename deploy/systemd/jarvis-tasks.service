# JARVIS Aufgabenplaner als Dienst (VORLAGE – erst nach deiner Freigabe einrichten)
[Unit]
Description=JARVIS Aufgabenplaner
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
Environment=TZ=Europe/Berlin
Environment=JARVIS_CONFIG=/etc/jarvis/jarvis.json
Environment=JARVIS_DATA_DIR=/var/lib/jarvis/data
Environment=JARVIS_VAULT_DIR=/var/lib/jarvis/data/vault
Environment=PYTHONUNBUFFERED=1
LoadCredential=JARVIS_APPROVAL_SECRET:/etc/jarvis/credentials/JARVIS_APPROVAL_SECRET
ExecStart=/usr/bin/python3 -m jarvis aufgaben
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/jarvis
UMask=0077

[Install]
WantedBy=multi-user.target
